---
import { getCollection, type CollectionEntry } from "astro:content";
import { librosPorSlug } from "../../data/libros";
import Layout from "../../layouts/Layout.astro";
import ImgDownload from "../../components/ImgDownload.astro";
import BotonIcono from "../../components/libro/BotonIcono.astro";
import Seccion from "../../components/libro/Seccion.astro";
import DatosBibliograficos from "../../components/libro/DatosBibliograficos.astro";

export async function getStaticPaths() {
  const entries = await getCollection("libros");
  const porSlug = new Map(
    entries.map((entry) => [entry.id.replace(/\.json$/, ""), entry]),
  );

  return [...librosPorSlug.entries()].map(([path, meta]) => {
    const slug = path.replace(/^\/libros\//, "");
    return {
      params: { slug },
      props: { meta, entry: porSlug.get(slug) ?? null },
    };
  });
}

const { meta, entry } = Astro.props;
const d = (entry as CollectionEntry<"libros"> | null)?.data;
---

<script>
  import QRCode from "qrcode";
  import { toCanvas } from "html-to-image";

  const boton = document.querySelector("#download-book");
  const imagen = document.querySelector("#img-download");
  const qr = document.querySelector("#book-qr");

  async function descargarLibro() {
    if (!boton || !imagen || !qr) {
      console.error("No se encontró el contenido exportable del libro.");
      return;
    }

    boton.disabled = true;
    boton.setAttribute("aria-busy", "true");

    try {
      qr.src = await QRCode.toDataURL(window.location.href, {
        errorCorrectionLevel: "M",
        margin: 1,
        width: 112,
      });
      await qr.decode();

      await document.fonts.ready;
      const bounds = imagen.getBoundingClientRect();
      const width = Math.ceil(Math.max(imagen.scrollWidth, bounds.width));
      const height = Math.ceil(Math.max(imagen.scrollHeight, bounds.height));
      const canvas = await toCanvas(imagen, {
        cacheBust: true,
        width,
        height,
        pixelRatio: 1,
        style: {
          width: `${width}px`,
          height: `${height}px`,
        },
      });
      const titulo = imagen.dataset.bookTitle ?? "libro";
      const blob = await new Promise((resolve, reject) => {
        canvas.toBlob((resultado) => {
          if (resultado) {
            resolve(resultado);
          } else {
            reject(new Error("No se pudo convertir la captura en una imagen."));
          }
        }, "image/png");
      });

      const link = document.createElement("a");
      link.download = `${titulo.toLowerCase().replace(/[^a-z0-9]+/gi, "-")}.png`;
      link.href = URL.createObjectURL(blob);
      link.click();
      URL.revokeObjectURL(link.href);
    } catch (error) {
      console.error("No se pudo guardar la imagen del libro.", error);
    } finally {
      boton.disabled = false;
      boton.removeAttribute("aria-busy");
    }
  }

  boton?.addEventListener("click", descargarLibro);
</script>

<Layout>
  <header class="sticky top-0 z-50 flex items-center justify-between gap-4 p-4">
    <BotonIcono
      label="Volver a la vista anterior"
      onclick="history.length > 1 ? history.back() : (location.href = '/libros')"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="1.25rem" height="1.25rem" viewBox="0 0 32 32">
        <path d="M0 0h32v32H0z" fill="none"></path>
        <path
          fill="currentColor"
          d="M11.369 6.225a1 1 0 0 1 1.406 1.406l-.068.076L9.414 11H19a7 7 0 0 1 .36 13.991L19 25h-9a1 1 0 0 1 0-2h9l.257-.007A5 5 0 0 0 19 13H9.414l3.293 3.293a1 1 0 0 1-1.414 1.414l-5-5a1 1 0 0 1 0-1.414l5-5z"
        ></path>
      </svg>
    </BotonIcono>

    <BotonIcono id="download-book" label="Guardar imagen del libro">
      <svg xmlns="http://www.w3.org/2000/svg" width="1.25rem" height="1.25rem" viewBox="0 0 16 16">
        <path d="M0 0h16v16H0z" fill="none"></path>
        <path
          fill="currentColor"
          d="M4 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1V9.5A1.5 1.5 0 0 1 5.5 8h5A1.5 1.5 0 0 1 12 9.5V13a1 1 0 0 0 1-1V5.621a1 1 0 0 0-.293-.707l-1.621-1.621A1 1 0 0 0 10.379 3H10v1.5A1.5 1.5 0 0 1 8.5 6h-2A1.5 1.5 0 0 1 5 4.5V3zm2 0v1.5a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5V3zm5 10V9.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5V13zM2 4a2 2 0 0 1 2-2h6.379a2 2 0 0 1 1.414.586l1.621 1.621A2 2 0 0 1 14 5.621V12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"
        ></path>
      </svg>
    </BotonIcono>
  </header>

  <main class="mx-auto flex w-full max-w-3xl flex-col gap-4 p-4 lg:p-8 xl:max-w-4xl">
    <div class="mb-4 text-center">
      <h1 class="mb-2 text-2xl font-bold">{d?.titulo}</h1>
      <p class="text-(--txt-secondary)">{meta.testamento} · {meta.seccion}</p>
    </div>

    {
      !d ? (
        <p class="aviso">
          No se encontró el JSON para <code>{meta.slug}</code>. Revisa que el
          archivo se llame <code>{meta.slug}.json</code>.
        </p>
      ) : (
        <div class="divide-y divide-(--txt-primary)/10">
          {d.datos_bibliograficos && (
            <div class="pb-8">
              <DatosBibliograficos
                datos={{
                  "url-bg": d.datos_bibliograficos["url-bg"] ?? "",
                  "url-autor": d.datos_bibliograficos["url-autor"] ?? "",
                  autor: d.datos_bibliograficos.autor ?? "",
                  destinatarios: d.datos_bibliograficos.destinatarios ?? "",
                  fecha: d.datos_bibliograficos.fecha ?? "",
                  estructura: d.datos_bibliograficos.estructura ?? "",
                  lugar: d.datos_bibliograficos.lugar,
                }}
              />
            </div>
          )}

          {d.contexto_historico && (
            <Seccion titulo="Contexto histórico">
              <p class="text-sm text-(--txt-secondary) sm:text-base">
                {d.contexto_historico}
              </p>
            </Seccion>
          )}

          {d.personajes?.length > 0 && (
            <Seccion titulo="Personajes">
              <ul class="flex flex-wrap gap-8">
                {d.personajes.map((p) => (
                  <li class="flex items-center text-center min-w-0 flex-1 basis-64 flex-col gap-4">
                    {p["url-img"] ? (
                      <img
                        src={p["url-img"]}
                        alt={p.nombre}
                        class="size-32 shrink-0 rounded-3xl bg-(--txt-tertiary) object-cover"
                      />
                    ) : (
                      <div
                        class="flex size-32 shrink-0 items-center justify-center rounded-3xl bg-(--txt-tertiary)"
                        aria-label={`Sin imagen de ${p.nombre}`}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" class="size-16">
                          <path d="M0 0h24v24H0z" fill="none" />
                          <path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1" />
                        </svg>
                      </div>
                    )}
                    <p>
                      <span class="font-semibold text-(--txt-primary)">{p.nombre}: </span>
                      <span class="text-(--txt-secondary)">{p.descripcion}</span>
                    </p>
                  </li>
                ))}
              </ul>
            </Seccion>
          )}

          {d.contenido && (
            <Seccion titulo="Contenido">
              <p class="text-(--txt-secondary)">{d.contenido}</p>
            </Seccion>
          )}

          {d.sintesis && (
            <Seccion titulo="Síntesis">
              <p class="text-(--txt-secondary)">{d.sintesis}</p>
            </Seccion>
          )}

          {d.bosquejo?.length > 0 && (
            <Seccion titulo="Bosquejo" centrado>
              <ol class="flex flex-col gap-12 text-center text-sm text-(--txt-secondary) sm:text-base">
                {d.bosquejo.map((b) => (
                  <li>
                    <span class="font-semibold text-(--txt-primary)">{b.seccion}</span>
                    <p>{b.descripcion}</p>
                  </li>
                ))}
              </ol>
            </Seccion>
          )}
        </div>
      )
    }
  </main>

  {
    d && (
      <div class="absolute -left-[10000px] top-0" aria-hidden="true">
        <ImgDownload data={d} meta={meta} />
      </div>
    )
  }

  <blockquote class="mt-16 bg-(--red-color) p-8 py-24 text-sm text-(--txt-tertiary) sm:text-base">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 p-4 pt-0 lg:p-8 lg:pt-0 xl:max-w-4xl">
      “{d?.versiculo_clave?.texto}”
      <footer>— {d?.versiculo_clave?.pasaje}</footer>
    </div>
  </blockquote>
</Layout>