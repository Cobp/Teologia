---
import Marker from "../assets/marker.svg";
---

<div class="flex w-full h-full justify-center gap-4 mt-20 p-6">
  <Marker class="absolute top-0 left-8 lg:size-20" />
  <div class="flex flex-col items-center gap-4">
    <h1
      class="text-3xl font-semibold flex flex-col items-center justify-center gap-2 text-center"
    >
      <span> PANORAMA </span>
      <span class="text-6xl text-[var(--red-color)]"> BÍBLICO </span>
    </h1>
    <p class="text-lg text-center font-medium mt-4 max-w-md">
      Explora y comprende cómo cada libro encaja dentro de la gran historia de
      las Escrituras.
    </p>
    <a href="/libros"
      class="my-8 py-2 px-6 border-2 border-white/15 cursor-pointer bg-[var(--red-color)] hover:bg-red-800 text-white rounded-xl transition-colors duration-300"
    >
      Explorar Libros
    </a>

    <!-- Avatares agregados -->
    <div class="flex items-center space-x-3 mt-2">
      <img 
        src="/avatar1.jpg" 
        alt="Avatar 1" 
        class="w-12 h-12 rounded-full border-2 border-[var(--red-color)] object-cover shadow-sm"
      />
      <img 
        src="/avatar2.jpg" 
        alt="Avatar 2" 
        class="w-12 h-12 rounded-full border-2 border-[var(--red-color)] object-cover shadow-sm"
      />
    </div>
  </div>
</div>