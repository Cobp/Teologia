---
import { getCollection, type CollectionEntry } from "astro:content";
import { librosPorSlug } from "../../data/libros";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("libros");
  const porSlug = new Map(
    entries.map((entry) => [entry.id.replace(/\.json$/, ""), entry]),
  );

  return [...librosPorSlug.entries()].map(([path, meta]) => {
    const slug = path.replace(/^\/libros\//, "");

    return {
      params: { slug },
      props: { meta, entry: porSlug.get(slug) ?? null },
    };
  });
}

const { meta, entry } = Astro.props;
const d = (entry as CollectionEntry<"libros"> | null)?.data;
---

<Layout>
  <header class="sticky top-0 flex justify-between items-center gap-4 p-4 z-50">
    <button
      type="button"
      aria-label="Volver a la vista anterior"
      onclick="history.back()"
      class="p-2 text-(--txt-primary) bg-(--txt-tertiary) rounded-full flex items-center justify-center cursor-pointer md:opacity-50 hover:opacity-100 transition"
    >
      <i>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.25rem"
          height="1.25rem"
          viewBox="0 0 32 32"
        >
          <path d="M0 0h32v32H0z" fill="none"></path>
          <path
            fill="currentColor"
            d="M11.369 6.225a1 1 0 0 1 1.406 1.406l-.068.076L9.414 11H19a7 7 0 0 1 .36 13.991L19 25h-9a1 1 0 0 1 0-2h9l.257-.007A5 5 0 0 0 19 13H9.414l3.293 3.293a1 1 0 0 1-1.414 1.414l-5-5a1 1 0 0 1 0-1.414l5-5z"
          ></path>
        </svg>
      </i>
    </button>
    <button
      type="button"
      class="p-2 text-(--txt-primary) bg-(--txt-tertiary) rounded-full flex items-center justify-center cursor-pointer md:opacity-50 hover:opacity-100 transition-opacity duration-300"
    >
      <i>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.25rem"
          height="1.25rem"
          viewBox="0 0 16 16"
        >
          <path d="M0 0h16v16H0z" fill="none"></path>
          <path
            fill="currentColor"
            d="M4 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1V9.5A1.5 1.5 0 0 1 5.5 8h5A1.5 1.5 0 0 1 12 9.5V13a1 1 0 0 0 1-1V5.621a1 1 0 0 0-.293-.707l-1.621-1.621A1 1 0 0 0 10.379 3H10v1.5A1.5 1.5 0 0 1 8.5 6h-2A1.5 1.5 0 0 1 5 4.5V3zm2 0v1.5a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5V3zm5 10V9.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5V13zM2 4a2 2 0 0 1 2-2h6.379a2 2 0 0 1 1.414.586l1.621 1.621A2 2 0 0 1 14 5.621V12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"
          ></path>
        </svg>
      </i>
    </button>
  </header>

  <div
    class="max-w-3xl xl:max-w-4xl w-full mx-auto flex flex-col gap-4 p-4 lg:p-8"
  >
    <div class="text-center mb-4">
      <h1 class="text-2xl font-bold mb-2">{d?.titulo}</h1>
      <p class="text-(--txt-secondary)">
        {meta.testamento} · {meta.seccion}
      </p>
    </div>

    {
      !d ? (
        <p class="aviso">
          No se encontró el JSON para <code>{meta.slug}</code>. Revisa que el
          archivo se llame <code>{meta.slug}.json</code>.
        </p>
      ) : (
        <>
          {d.datos_bibliograficos && (
            <div class="grid grid-cols-[300px_1fr] gap-4">
              <div class="col-span-2 flex flex-col relative">
                <img
                  src={d.datos_bibliograficos["url-bg"]}
                  alt="Portada del libro"
                  class="w-full h-52 md:h-80 rounded-4xl bg-amber-200"
                />
                {d.datos_bibliograficos.lugar && (
                  <p class="hidden md:block px-2.5 text-sm text-(--txt-secondary) absolute bottom-4 right-4 bg-(--bg-primary) p-1 rounded-xl">
                    {d.datos_bibliograficos.lugar}
                  </p>
                )}
              </div>
              <div class="col-span-2 md:col-span-1 flex flex-col md:gap-2 items-center relative p-4">
                <div class="h-24">
                  <img
                    src=""
                    alt=""
                    class="size-48 md:size-52 -translate-y-32 rounded-full border-8 border-(--bg-primary) bg-amber-200"
                  />
                </div>
                <div class="text-center">
                  <p class="text-xl font-semibold uppercase">
                    {d.datos_bibliograficos.autor}
                  </p>
                  <p class="font-medium text-(--txt-secondary)">Autor</p>
                </div>
              </div>
              <div class="p-4 flex flex-col gap-4 text-(--txt-secondary) font-medium">
                <p>
                  <span class="font-semibold text-(--txt-primary)">
                    Destinatario:
                  </span>{" "}
                  {d.datos_bibliograficos.destinatarios}
                </p>
                <p>
                  <span class="font-semibold text-(--txt-primary)">Fecha:</span>{" "}
                  {d.datos_bibliograficos.fecha}
                </p>
                <p>{d.datos_bibliograficos.estructura}</p>
              </div>
            </div>
          )}
          <hr />
          {d.contexto_historico && (
            <section>
              <h2 class="font-semibold md:text-xl pb-4">Contexto histórico</h2>
              <p class="text-(--txt-secondary) text-sm sm:text-base">
                {d.contexto_historico}
              </p>
            </section>
          )}
          <hr />
          {d.personajes.length > 0 && (
            <section>
              <h2 class="font-semibold md:text-xl mb-4">Personajes</h2>
              <ul class="flex flex-col gap-4">
                {d.personajes.map((p) => (
                  <li class="flex gap-4">
                    {p["url-img"] && (
                      <img
                        src={p["url-img"]}
                        alt={p.nombre}
                        class="shrink-0 size-32 lg:size-42 bg-amber-200"
                      />
                    )}
                    <p>
                      <span class="font-semibold text-(--txt-primary)">
                        {p.nombre}:{" "}
                      </span>
                      <span class="text-(--txt-secondary)">
                        {p.descripcion}
                      </span>
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}
          <hr />
          {d.contenido && (
            <section>
              <h2 class="font-semibold md:text-xl mb-4">Contenido</h2>
              <p class="text-(--txt-secondary)">{d.contenido}</p>
            </section>
          )}
          <hr />
          {d.sintesis && (
            <section>
              <h2 class="font-semibold md:text-xl mb-4">Síntesis</h2>
              <p class="text-(--txt-secondary)">{d.sintesis}</p>
            </section>
          )}
          <hr />

          {d.bosquejo.length > 0 && (
            <section>
              <h2 class="text-center font-semibold md:text-xl mb-8">
                Bosquejo
              </h2>
              <ol class="flex flex-col text-center gap-12 text-(--txt-secondary) text-sm sm:text-base">
                {d.bosquejo.map((b) => (
                  <li>
                    <span class="font-semibold text-(--txt-primary)">
                      {b.seccion}
                    </span>
                    <p>{b.descripcion}</p>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </>
      )
    }
  </div>

  <blockquote
    class="text-(--txt-tertiary) bg-(--red-color) p-8 py-24 mt-16 text-sm sm:text-base"
  >
    <div
      class="max-w-3xl xl:max-w-4xl w-full mx-auto flex flex-col gap-4 p-4 lg:p-8 pt-0"
    >
      “{d?.versiculo_clave?.texto}”<footer>
        — {d?.versiculo_clave?.pasaje}
      </footer>
    </div>
  </blockquote>
</Layout>

<style>
  hr {
    opacity: 0.1;
    margin: 2rem 0;
  }
</style>
