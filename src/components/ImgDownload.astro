---
import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"libros">["data"];
  meta: {
    testamento: string;
    seccion: string;
  };
}

const { data, meta } = Astro.props;
const bibliografia = data.datos_bibliograficos;
const imageStyle = (url?: string) =>
  url ? `background-image: url("${url}")` : undefined;
const personajes = data.personajes;
const bosquejo = data.bosquejo;
const coloresBosquejo = [
  "#e8f1f5",
  "#f5eedf",
  "#e8f2e8",
  "#eee8f4",
  "#f5e8e5",
  "#e8eef5",
];
const sintesisPartes = (data.sintesis ?? "")
  .split(
    /(?=En los capítulos\s+\d+(?:\s*(?:[-–—]|al)\s*\d+)?)/i,
  )
  .map((parte) => parte.trim())
  .filter(Boolean);
---

<main
  id="img-download"
  data-book-title={data.titulo}
  class="relative mx-auto w-[1000px] space-y-4 bg-(--bg-primary) p-8 text-(--txt-primary)"
>
  <div
    class="absolute top-0 left-0 w-full h-120 bg-cover bg-top mask-b-from-20% mask-b-to-80% pointer-events-none"
    style={imageStyle(bibliografia["url-bg"])}
  >
  </div>
  <header class="relative flex min-h-80 items-center justify-center p-6">
    <div
      class="relative z-10 flex flex-col items-center rounded-xl bg-azul px-8 py-4 text-center text-(--txt-tertiary) gap-2"
    >
      <h1
        class="bg-(--txt-primary) text-5xl font-extrabold tracking-wide px-8 py-4 rounded-lg w-xl"
      >
        {data.titulo}
      </h1>
      <p class="text-lg bg-(--red-color) font-medium px-8">
        {meta.testamento} · {meta.seccion}
      </p>
    </div>
  </header>

  <section
    class="rounded-2xl grid grid-cols-[1fr_256px] bg-(--txt-tertiary) p-8 z-10 gap-8"
  >
    <div class="">
      <h2
        class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
      >
        A. Datos bibliográficos
      </h2>
      <ul class="space-y-3 text-sm columns-2 col-span- w-full">
        <li><b>Autor:</b> {bibliografia.autor ?? "No especificado"}</li>
        <li>
          <b>Destinatarios:</b>
          {bibliografia.destinatarios ?? "No especificado"}
        </li>
        <li><b>Fecha:</b> {bibliografia.fecha ?? "No especificada"}</li>
        <li><b>Lugar:</b> {bibliografia.lugar ?? "No especificado"}</li>
        <li>
          <b>Estructura:</b>
          {bibliografia.estructura ?? "No especificada"}
        </li>
        <li>
          <b>Ubicación:</b>
          {bibliografia.ubicacion ?? "No especificada"}
        </li>
      </ul>
    </div>
    <div
      class="size-64 rounded-xl bg-cover bg-center"
      style={imageStyle(bibliografia["url-autor"])}
    >
    </div>
  </section>

  <div class="grid grid-cols-[0.8fr_1.2fr] gap-4">
    <section class="row-start-1 rounded-2xl bg-(--txt-tertiary) p-6">
      <h2
        class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
      >
        B. Contexto histórico
      </h2>
      <p class="text-sm leading-relaxed">
        {data.contexto_historico ?? "No especificado."}
      </p>
    </section>

    <section
      class="col-start-2 row-span-2 row-start-1 rounded-2xl bg-(--txt-tertiary) p-8"
    >
      <h2
        class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
      >
        C. Personajes
      </h2>
      <div class="flex flex-wrap justify-center gap-4">
        {
          personajes.map((personaje) => (
            <div class="flex flex-col items-center w-[31%] min-w-0 gap-3 rounded-xl p-4">
              <div
                class="h-16 w-16 shrink-0 rounded-full bg-amber-200 bg-contain bg-center bg-no-repeat"
                style={imageStyle(personaje["url-img"])}
              />
              <p class="min-w-0 text-center text-sm leading-relaxed">
                <b>{personaje.nombre}:</b> {personaje.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="col-start-1 row-start-2 rounded-2xl bg-(--txt-tertiary) p-8"
    >
      <h2
        class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
      >
        D. Contenido
      </h2>
      <p class="text-sm leading-relaxed">
        {data.contenido ?? "No especificado."}
      </p>
    </section>
  </div>

  <section class="rounded-2xl bg-(--txt-tertiary) p-8">
    <h2
      class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
    >
      E. Síntesis
    </h2>
    <div class="grid grid-cols-2 gap-8">
      {!sintesisPartes.length && (
        <p class="col-span-2 text-sm leading-relaxed">No especificada.</p>
      )}
      {
        sintesisPartes.map((parte) => {
          const rango = parte.match(
            /En los capítulos\s+\d+(?:\s*(?:[-–—]|al)\s*\d+)?/i,
          );
          const indiceRango = rango ? parte.indexOf(rango[0]) : -1;

          return (
            <p class="text-sm leading-relaxed">
              {rango && indiceRango >= 0 ? (
                <>
                  {parte.slice(0, indiceRango)}
                  <strong class="font-extrabold">
                    {rango[0]}
                  </strong>
                  {parte.slice(indiceRango + rango[0].length)}
                </>
              ) : (
                parte
              )}
            </p>
          );
        })
      }
    </div>
  </section>

  <section class="rounded-2xl bg-(--txt-tertiary) p-8">
    <h2
      class="mb-4 inline-block rounded text-lg font-bold text-(--txt-primary)"
    >
      F. Bosquejo
    </h2>
    <div class="flex flex-wrap justify-center gap-3">
      {
        bosquejo.map((parte, index) => (
          <article
            class="flex w-[31%] flex-col rounded-xl p-4 text-center"
            style={`background-color: ${coloresBosquejo[index % coloresBosquejo.length]}`}
          >
            <h3 class="font-bold text-azul">
              {index + 1}. {parte.seccion}
            </h3>
            <p class="my-2 text-sm">{parte.descripcion}</p>
          </article>
        ))
      }
    </div>
  </section>
  <section class="flex gap-4">
    <div class="rounded-2xl bg-(--txt-tertiary) p-8">
      «{data.versiculo_clave?.texto}»{" "}
      <b class="not-italic">{data.versiculo_clave?.pasaje}</b>
    </div>

    <div class="min-w-[128px] rounded-lg bg-white p-2 shadow-md">
      <img
        id="book-qr"
        width="112"
        height="112"
        alt={`Código QR para abrir ${data.titulo}`}
        class="block size-28"
      />
    </div>
  </section>
</main>
