---
import Marker from "../assets/marker.svg";
import avatar1 from "../assets/avatar1.webp";
---

<div class="flex w-full h-full justify-center gap-4 mt-20 p-6">
  <Marker class="absolute top-0 left-8 lg:size-20" />
  <div class="flex flex-col items-center gap-4">
    <h1
      class="text-3xl font-semibold flex flex-col items-center justify-center gap-2 text-center"
    >
      <span> PANORAMA </span>
      <span class="text-6xl text-[var(--red-color)]"> BÍBLICO </span>
    </h1>
    <p class="text-lg text-center font-medium mt-4 max-w-md">
      Explora y comprende cómo cada libro encaja dentro de la gran historia de
      las Escrituras.
    </p>

    <!-- AGREGADO: "relative z-20" para poner el botón por delante del avatar -->
    <a href="/libros"
      class="relative z-20 my-8 py-2 px-6 border-2 border-white/15 cursor-pointer bg-[var(--red-color)] hover:bg-red-800 text-white rounded-xl transition-colors duration-300"
    >
      Explorar Libros
    </a>

    <!-- SE MANTIENE EL TAMAÑO Y MARGEN EXACTOS (-mt-40 y h-100) -->
    <!-- AGREGADO: "pointer-events-none" por si acaso, y "relative z-10" para el orden de capas -->
    <div class="flex items-end -space-x0 -mt-40 relative z-10 pointer-events-none">
      <img 
        src={avatar1.src} 
        alt="Avatar 1" 
        class="h-100 w-auto object-contain"
      />
    </div>
  </div>
</div>