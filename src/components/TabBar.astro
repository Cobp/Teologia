---
import { testamentos } from "../data/libros";

const showPanel = [
  "[&:has(#tab-0:checked)_#panel-0]:flex",
  "[&:has(#tab-1:checked)_#panel-1]:flex",
];
---

<div class:list={["flex flex-col gap-4", showPanel]}>
  <div
    class="flex w-fit h-9 p-0.75 rounded-full bg-(--bg-secondary) text-[15px]"
    role="tablist"
  >
    {
      testamentos.map((t, i) => (
        <label
          role="tab"
          class="relative flex items-center justify-center w-40 rounded-full cursor-pointer text-sm font-medium text-center text-(--txt-secondary) transition-all has-checked:bg-(--bg-primary) has-checked:text-(--txt-primary)"
        >
          <input
            type="radio"
            name="testamento"
            id={`tab-${i}`}
            class="sr-only"
            checked={i === 0}
          />
          {t.nombre}
        </label>
      ))
    }
  </div>

  {
    testamentos.map((t, i) => (
      <section
        id={`panel-${i}`}
        role="tabpanel"
        class="hidden flex-col gap-4"
      >
        {t.secciones.map((s) => (
          <article class="grid grid-cols-[1fr_1.2fr] items-start gap-3 rounded-xl bg-[#fffbe4] p-3.5">
            <h2 class="pl-2 font-semibold text-(--txt-primary)">
              {s.nombre}
            </h2>
            <ul class="flex flex-col">
              {s.libros.map((l) => (
                <li class="flex flex-col">
                  <a
                    href={`/libros/${l.slug}`}
                    style={`--c:${l.color}`}
                    class="block h-8 rounded-md border border-black/15 bg-(--c) px-1.5 py-1.5 text-center text-[0.6rem] uppercase tracking-[0.03em] text-white no-underline transition hover:brightness-110 active:scale-[0.98]"
                  >
                    {l.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    ))
  }
</div>