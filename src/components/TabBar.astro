---
import { testamentos } from "../data/libros";
---

<div data-tabs>
  <div class="segmented" role="tablist">
    {
      testamentos.map((t, i) => (
        <button
          role="tab"
          type="button"
          class:list={["tab", { active: i === 0 }]}
          aria-selected={i === 0}
          data-target={`panel-${i}`}
        >
          {t.nombre}
        </button>
      ))
    }
  </div>

  {
    testamentos.map((t, i) => (
      <section id={`panel-${i}`} role="tabpanel" class="panel" hidden={i !== 0}>
        {t.secciones.map((s) => (
          <article class="card">
            <h2 class="seccion">{s.nombre}</h2>
            <ul class="flex flex-wrap libros">
              {s.libros.map((l) => (
                <li>
                  <a
                    href={`/libros/${l.slug}`}
                    style={`--c:${l.color}`}
                    class={`block items-center uppercase  h-8 rounded-md bg-(--c) border border-black/15`}
                  >
                    {l.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>(".tab");
    const panels = root.querySelectorAll<HTMLElement>(".panel");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("active", active);
          t.setAttribute("aria-selected", String(active));
        });
        panels.forEach((p) => (p.hidden = p.id !== tab.dataset.target));
      });
    });
  });
</script>

<style>
  .segmented {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: #e9e2b4;
    margin-bottom: 1rem;
  }
  .tab {
    flex: 1;
    border: 0;
    background: transparent;
    border-radius: 999px;
    padding: 0.4rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #8a8566;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .tab.active {
    background: #fff;
    color: #12304a;
    box-shadow: 0 1px 3px #0002;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 0.75rem;
    align-items: start;
    background: #fffbe4;
    border-radius: 12px;
    padding: 0.9rem;
  }
  .seccion {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.25;
    color: #12304a;
  }

  .libros {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .libros a {
    display: block;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    padding: 0.4rem 0.3rem;
    color: #fff;
    background: var(--c);
    transition:
      filter 0.15s,
      transform 0.1s;
  }
  .libros a:hover {
    filter: brightness(1.12);
  }
  .libros a:active {
    transform: scale(0.98);
  }
</style>
